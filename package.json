{
  "name": "dsh-model-http-proxy",
  "description": "按域名决定哪些 HTTP 请求走代理或直连（Route requests per domain through a proxy; everything else stays direct）",
  "version": "0.1.3",
  "packageManager": "pnpm@9.15.9",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guhanfei-ai/dsh-model-http-proxy.git"
  },
  "homepage": "https://github.com/guhanfei-ai/dsh-model-http-proxy#readme",
  "bugs": "https://github.com/guhanfei-ai/dsh-model-http-proxy/issues",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "proxy",
    "http-proxy",
    "socks",
    "cordis",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types",
    "cordis.patch.yml"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown",
    "prepublishOnly": "npm run verify",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build && npm run test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-store": "^0.1.7-alpha.0 || ^0.2.0-alpha.0 || ^0.2.1-alpha.0",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-alpha.0 || ^0.2.0-alpha.0 || ^0.2.1-alpha.0",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-alpha.0 || ^0.2.0-alpha.0 || ^0.2.1-alpha.0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-alpha.0 || ^0.2.0-alpha.0 || ^0.2.1-alpha.0",
    "@deepseek-ai/dsh-settings": "^0.1.7-alpha.0 || ^0.2.0-alpha.0 || ^0.2.1-alpha.0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.2",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
